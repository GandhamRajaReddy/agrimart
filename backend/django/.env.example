DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Database: use django.db.backends.postgresql for production, django.db.backends.sqlite3 for local standalone testing
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=agrimart
DATABASE_USER=agrimart
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5176

# Optional Harvestify ML service
ML_SERVICE_ENABLED=False
ML_SERVICE_URL=http://127.0.0.1:8100
ML_CONNECT_TIMEOUT=2
ML_READ_TIMEOUT=20

# Private data.gov.in credential; keep server-side and out of source control.
DATA_GOV_IN_API_KEY=

# Set True only after verified datasets and temporal backtesting are complete.
MARKET_FORECAST_MODEL_VALIDATED=False
