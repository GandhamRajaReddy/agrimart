# ============================================================
# AgriMart Production Environment Variables
# ============================================================

# Security
DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=generate-a-secure-50-character-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (PostgreSQL)
DATABASE_NAME=agrimart
DATABASE_USER=agrimart
DATABASE_PASSWORD=replace_with_a_strong_database_password
DATABASE_HOST=db
DATABASE_PORT=5432

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://yourdomain.com

# Harvestify ML Service
ML_SERVICE_ENABLED=True
ML_SERVICE_URL=http://ml-service:8100
ML_CONNECT_TIMEOUT=2
ML_READ_TIMEOUT=20

# External Integrations (Optional)
DATA_GOV_IN_API_KEY=
MARKET_FORECAST_MODEL_VALIDATED=False

